# ---------------------------------------------------------------------------
# DevHire Tracker — environment variables
# Copy this file to `.env` and fill in the values.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by the app at runtime.
# On Neon this is the "Pooled connection" string (host contains `-pooler`).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devhire?schema=public"

# Direct (unpooled) connection used only by Prisma for migrations.
# Locally this can be identical to DATABASE_URL. On Neon, copy the
# "Direct connection" string (no `-pooler` in the host).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/devhire?schema=public"

# NextAuth / Auth.js secret.
# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"

# Public base URL used by Auth.js in production (optional in development).
# AUTH_URL="https://your-app.vercel.app"

# Google OAuth (optional — the Google button only renders when both are set).
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Demo account shown on the login screen.
# Override these if you seed a different demo user.
NEXT_PUBLIC_DEMO_EMAIL="demo@devhire.app"
NEXT_PUBLIC_DEMO_PASSWORD="demo1234"
